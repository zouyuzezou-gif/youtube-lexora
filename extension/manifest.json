{
  "manifest_version": 3,
  "name": "YouTube Lexora",
  "version": "0.2.0",
  "description": "在已登录的 YouTube 页面中学习中英字幕，并用 AI 理解语境。",
  "permissions": ["sidePanel", "storage", "unlimitedStorage", "tabs"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://api.deepseek.com/*",
    "https://api.supadata.ai/*"
  ],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "打开 YouTube Lexora", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
